# Copia este archivo a .env y llena los valores. NUNCA subas .env al repo.

# --- pey (portal.mipey.mx) ---
PEY_API_KEY=
PEY_BASE_URL=https://api.pey.mx
PEY_WEBHOOK_SECRET=
# Solo para depurar en local. Nunca en producción.
PEY_WEBHOOK_INSECURE=0

# --- WhatsApp Cloud API (developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- LLM (cliente compatible con OpenAI) ---
# Grok (xAI):  https://api.x.ai/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- App ---
# Teléfonos del dueño, 10 dígitos, separados por coma
OWNER_PHONES=
# URL pública (Render/Railway o túnel), sin diagonal final
PUBLIC_BASE_URL=
# Clave simple para /panel y /api/*
PANEL_KEY=
DATABASE_PATH=data/app.db
